# DingChi 周报后端环境变量示例
#
# 使用说明：
# 1. 本地开发复制/参考本文件，实际运行使用 backend/.env.development。
# 2. 生产环境复制本文件或 .env.production.example 为未提交的 .env.production，
#    并通过 ENV_FILE 指向该文件。
# 3. 所有 CHANGE_ME、replace-with-*、your-* 仅为占位符，禁止直接用于生产。
# 4. 每个配置项只在本文件中出现一次，按模块分组维护。

# ============================================================================
# 01. 应用与运行环境
# ============================================================================

# Django 运行环境名称，可选 development、test、production。
DJANGO_ENV=development
# Django 签名和加密使用的密钥；本地和生产必须使用不同的随机高熵值。
DJANGO_SECRET_KEY=replace-with-a-local-random-string
# 是否开启调试模式；生产环境必须为 false。
DJANGO_DEBUG=true
# 允许访问的主机列表，多个主机使用英文逗号分隔。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Django 国际化语言代码。
LANGUAGE_CODE=zh-hans
# Django 时区名称。
TIME_ZONE=Asia/Shanghai
# 是否启用 Django 国际化。
USE_I18N=true
# 是否启用时区感知时间。
USE_TZ=true
# Django 默认主键字段类型；业务主键仍由雪花算法生成。
DEFAULT_AUTO_FIELD=django.db.models.BigAutoField

# ============================================================================
# 02. 跨域、CSRF 与 HTTPS 安全策略
# ============================================================================

# 允许跨域访问的前端地址，多个地址使用英文逗号分隔。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 允许执行 CSRF 请求的来源，多个地址使用英文逗号分隔。
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS 允许的 HTTP 方法，使用英文逗号分隔。
CORS_ALLOWED_METHODS=DELETE,GET,OPTIONS,PATCH,POST,PUT
# CORS 允许的请求头，星号表示允许任意请求头；生产应改为明确列表。
CORS_ALLOW_HEADERS=*
# CORS 暴露给浏览器的响应头，使用英文逗号分隔。
CORS_EXPOSE_HEADERS=Mcp-Session-Id,X-Trace-ID
# 是否允许跨域请求携带凭证。
CORS_ALLOW_CREDENTIALS=true
# 反向代理传递原始协议时使用的请求头名称；生产必须与网关一致。
SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
# 反向代理传递的 HTTPS 协议值。
SECURE_PROXY_SSL_HEADER_VALUE=https
# 是否强制把 HTTP 重定向到 HTTPS；生产环境必须为 true。
SECURE_SSL_REDIRECT=false
# 是否只通过 HTTPS 发送会话 Cookie；生产环境必须为 true。
SESSION_COOKIE_SECURE=false
# 是否只通过 HTTPS 发送 CSRF Cookie；生产环境必须为 true。
CSRF_COOKIE_SECURE=false
# HSTS 生效秒数；开发环境设为 0。
SECURE_HSTS_SECONDS=0
# HSTS 是否包含子域名。
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# HSTS 是否声明 preload。
SECURE_HSTS_PRELOAD=false

# ============================================================================
# 03. 静态资源、媒体文件与附件
# ============================================================================

# 静态资源 URL 前缀。
STATIC_URL=/static/
# 静态资源收集目录；支持绝对路径，相对路径相对 backend 目录解析。
STATIC_ROOT=staticfiles
# 媒体资源 URL 前缀。
MEDIA_URL=/media/
# 媒体/附件存储根目录；支持宿主机绝对路径，例如 /opt/dingchi-week-report/data/files；
# 相对路径相对 backend 目录解析。
MEDIA_ROOT=media
# 单个附件最大大小，单位为字节。
ATTACHMENT_MAX_SIZE_BYTES=10485760
# 附件允许的扩展名，多个扩展名使用英文逗号分隔。
ATTACHMENT_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.png,.jpg,.jpeg,.gif,.zip,.txt
# 附件分类子目录；相对于 MEDIA_ROOT，不填写宿主机绝对路径。
ATTACHMENT_UPLOAD_DIR=weekly-report

# ============================================================================
# 04. MySQL 数据库连接与连接池
# ============================================================================

# 业务数据库名称。
MYSQL_DATABASE=dingchi_week_report
# Django 连接 MySQL 使用的用户名。
MYSQL_USER=dingchi
# Django 连接 MySQL 使用的密码；示例值仅为占位符。
MYSQL_PASSWORD=replace-me
# MySQL 主机地址。
MYSQL_HOST=127.0.0.1
# MySQL 服务端口。
MYSQL_PORT=3306
# MySQL 字符集。
MYSQL_CHARSET=utf8mb4
# 建立连接后的初始化 SQL。
MYSQL_INIT_COMMAND=SET sql_mode='STRICT_TRANS_TABLES', time_zone='+08:00'
# MySQL 建立连接超时时间，单位为秒。
MYSQL_CONNECT_TIMEOUT=5
# Django 请求级持久连接时长，单位为秒。使用 SQLAlchemy 连接池时必须为 0，
# 由连接池负责复用并在请求结束后归还连接，避免连接长期占用池内槽位。
MYSQL_CONN_MAX_AGE=0
# 是否在复用 MySQL 连接前执行健康检查。
MYSQL_CONN_HEALTH_CHECKS=true
# MySQL 连接池常驻连接数。
MYSQL_POOL_SIZE=10
# MySQL 连接池允许超出的临时连接数。
MYSQL_POOL_MAX_OVERFLOW=10
# MySQL 连接池获取连接超时时间，单位为秒。
MYSQL_POOL_TIMEOUT=30
# MySQL 连接池连接回收周期，单位为秒。
MYSQL_POOL_RECYCLE=900
# 从连接池取出连接前是否执行健康检查。
MYSQL_POOL_PRE_PING=true

# ============================================================================
# 05. Redis 连接与连接池
# ============================================================================

# Redis 连接地址，格式为 redis://[:密码]@主机:端口/数据库编号。
REDIS_URL=redis://127.0.0.1:6379/0
# Redis 服务密码；当密码已写入 REDIS_URL 时仍保留此配置供基础设施使用。
REDIS_PASSWORD=replace-me
# Redis 连接池最大连接数。
REDIS_POOL_MAX_CONNECTIONS=50
# Redis 连接池健康检查间隔，单位为秒。
REDIS_POOL_HEALTH_CHECK_INTERVAL=30
# Redis 建立连接超时时间，单位为秒。
REDIS_SOCKET_CONNECT_TIMEOUT=3
# Redis 读写超时时间，单位为秒。
REDIS_SOCKET_TIMEOUT=3
# Redis 不可用时是否忽略异常并降级；关键链路应设置为 false。
REDIS_IGNORE_EXCEPTIONS=false

# ============================================================================
# 06. AI 大模型服务
# ============================================================================

# OpenAI-compatible 服务访问密钥；禁止提交真实密钥。
AI_API_KEY=
# OpenAI-compatible 服务地址；留空时使用 SDK 默认地址。
AI_BASE_URL=
# 使用的大模型名称。
AI_MODEL=your-model-name
# AI 请求超时时间，单位为秒。
AI_TIMEOUT_SECONDS=60

# ============================================================================
# 07. 雪花算法主键
# ============================================================================

# 雪花算法自定义纪元时间，Unix 毫秒时间戳；同一部署环境必须保持稳定。
SNOWFLAKE_EPOCH_MS=1704067200000
# 雪花算法工作节点编号，范围 0-31；不同进程/实例必须唯一。
SNOWFLAKE_WORKER_ID=1
# 雪花算法数据中心编号，范围 0-31；不同数据中心必须唯一。
SNOWFLAKE_DATACENTER_ID=1

# ============================================================================
# 08. 认证令牌
# ============================================================================

# 登录令牌签名盐；必填，生产环境使用随机高熵值。
AUTH_TOKEN_SALT=replace-with-random-auth-token-salt
# 登录令牌有效期，单位为秒；建议 28800。
AUTH_TOKEN_MAX_AGE_SECONDS=28800

# ============================================================================
# 09. RSA 密码加密
# ============================================================================

# RSA 私钥文件路径；支持宿主机绝对路径，相对路径相对 backend 目录解析。
CRYPTO_PRIVATE_KEY_PATH=.keys/private_key.pem
# RSA 公钥文件路径；支持宿主机绝对路径，相对路径相对 backend 目录解析。
CRYPTO_PUBLIC_KEY_PATH=.keys/public_key.pem
# RSA 私钥口令；生产环境必须通过密钥管理系统注入。
CRYPTO_PRIVATE_KEY_PASSWORD=
# RSA 密钥生成位数；仅供 scripts/generate_crypto_keys.py 使用，建议至少 2048。
CRYPTO_KEY_SIZE=2048

# ============================================================================
# 10. 日志与请求追踪
# ============================================================================

# 日志级别，可选 DEBUG、INFO、WARNING、ERROR、CRITICAL。
LOG_LEVEL=INFO
# 日志目录；支持宿主机绝对路径，例如 /opt/dingchi-week-report/data/logs；
# 相对路径相对 backend 目录解析，目录不存在时启动时创建。
LOG_DIR=logs
# 当前日志文件名；只填写文件名，不要填写目录或绝对路径。
LOG_FILE_NAME=backend.log
# 滚动日志单文件最大大小，单位为字节。
LOG_MAX_BYTES=10485760
# 滚动日志保留的历史文件数量。
LOG_BACKUP_COUNT=5
# 是否同时输出控制台日志，可选 true 或 false。
LOG_CONSOLE_ENABLED=true

# ============================================================================
# 11. 本地 Docker/基础设施编排（应用运行可不使用）
# ============================================================================

# Docker Compose 使用的 MySQL root 密码；仅供本地基础设施编排使用。
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
# Docker Compose 使用的数据库时区。
# Django 数据库连接读写 DATETIME 使用北京时间；与 USE_TZ=true 配合，API 保留时区。
MYSQL_TIME_ZONE=Asia/Shanghai
# Docker Compose 映射到宿主机的 MySQL 端口。
MYSQL_PUBLISHED_PORT=3306
# Docker Compose 映射到宿主机的 Redis 端口。
REDIS_PUBLISHED_PORT=6379
# MySQL 容器健康检查间隔，使用 Docker 时长格式，例如 10s。
MYSQL_HEALTHCHECK_INTERVAL=10s
# MySQL 容器健康检查超时时间，使用 Docker 时长格式。
MYSQL_HEALTHCHECK_TIMEOUT=5s
# MySQL 容器健康检查失败重试次数。
MYSQL_HEALTHCHECK_RETRIES=10
# Redis 容器健康检查间隔，使用 Docker 时长格式。
REDIS_HEALTHCHECK_INTERVAL=10s
# Redis 容器健康检查超时时间，使用 Docker 时长格式。
REDIS_HEALTHCHECK_TIMEOUT=5s
# Redis 容器健康检查失败重试次数。
REDIS_HEALTHCHECK_RETRIES=10

# ============================================================================
# 12. Auto-Ontology 语义层（vendor 集成，可选）
# ============================================================================

# 语义元数据/向量库（postgres+pgvector 容器）连接；不配置则 query_weekly_data 工具不可用，
# 其余 AI 助手功能不受影响。
ONTOLOGY_PG_HOST=127.0.0.1
ONTOLOGY_PG_PORT=5432
ONTOLOGY_PG_USER=postgres
ONTOLOGY_PG_PASSWORD=replace-with-ontology-pg-password
ONTOLOGY_PG_DATABASE=auto_ontology
